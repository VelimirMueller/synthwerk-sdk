{
  "name": "synthwerk-sdk",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "biome ci .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "pnpm -r run build",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "pack:all": "pnpm -r pack --pack-destination .pack",
    "release": "pnpm check && pnpm -r publish --access public"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@tanstack/query-core": "5.105.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "@vue/test-utils": "2.5.1",
    "happy-dom": "21.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "vue": "3.5.44"
  }
}
